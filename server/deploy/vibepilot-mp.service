# systemd unit for the VibePilot multiplayer relay on a Raspberry Pi (see MULTIPLAYER.md → Raspberry Pi).
#   sudo cp server/deploy/vibepilot-mp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now vibepilot-mp
#   journalctl -u vibepilot-mp -f
[Unit]
Description=VibePilot multiplayer relay
After=network-online.target
Wants=network-online.target

[Service]
# Recent Raspberry Pi OS images have no default "pi" user: change User and WorkingDirectory to yours
User=pi
WorkingDirectory=/home/pi/VibePilot
ExecStart=/usr/bin/node server/server.mjs
Environment=PORT=8787
# Localhost only: cloudflared (or Caddy) terminates TLS in front and forwards to it
Environment=HOST=127.0.0.1
Environment=ALLOWED_ORIGINS=https://szefo94.github.io
Restart=always
RestartSec=3
# Hardening: the relay needs no disk writes or privileges
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
MemoryMax=200M

[Install]
WantedBy=multi-user.target
