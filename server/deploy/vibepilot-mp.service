# systemd unit for the VibePilot multiplayer server on a Raspberry Pi.
# Guide: docs/multiplayer/server-setup-raspberry-pi.md
#   sudo cp server/deploy/vibepilot-mp.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now vibepilot-mp
#   journalctl -u vibepilot-mp -f
[Unit]
Description=VibePilot multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
User=vibepilot
WorkingDirectory=/opt/vibepilot/app
ExecStart=/usr/bin/node server/server.mjs
Environment=PORT=8787
# 127.0.0.1: only the tunnel (cloudflared / Tailscale) reaches it. Use 0.0.0.0 for LAN testing without a tunnel.
Environment=HOST=127.0.0.1
Restart=always
RestartSec=3
# Hardening: the server only reads the game files and needs no privileges
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=300M

[Install]
WantedBy=multi-user.target
